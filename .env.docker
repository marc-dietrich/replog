# Database
DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/gym_tracker
DATABASE_NAME=gym_tracker
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_ECHO=false

# JWT
SECRET_KEY=your-secret-key-change-in-production-at-least-32-characters-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
DEBUG=false
ENVIRONMENT=development

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Migration
MIGRATION_TOKEN_EXPIRY_DAYS=7
